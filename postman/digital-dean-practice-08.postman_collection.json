    {
      "name": "07 rejected sixth attempt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"{{lab_login}}\", \"password\": \"Synthetic wrong password 08!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status\", () => pm.response.to.have.status(429));",
              "pm.test(\"server request UUID\", () => {",
              "  pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.match(",
              "    /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);",
              "});",
              "pm.test(\"bounded rejection\", () => {",
              "  pm.expect(pm.response.json()).to.eql({detail:\"too many login attempts\"});",
              "  pm.expect(pm.response.headers.get(\"Retry-After\")).to.match(/^[1-9][0-9]*$/);",
              "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
              "});",
              "pm.collectionVariables.set(\"limit_request_id\", pm.response.headers.get(\"X-Request-ID\"));"
            ]
          }
        }
      ]
    },
