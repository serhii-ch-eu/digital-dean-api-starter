    {
      "name": "12 Block active account",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{base_url}}/api/v1/users/{{active_user_id}}/block"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"blocked safely\",()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(Object.keys(b).sort()).to.eql([\"email\",\"id\",\"login\",\"name\",\"status_id\"]);pm.expect(String(b.id)).to.eql(pm.collectionVariables.get(\"active_user_id\"));pm.expect(b.status_id).to.eql(2);});"
            ]
          }
        }
      ]
    },
