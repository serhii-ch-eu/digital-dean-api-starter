        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Навчальний користувач\", \"email\": \"{{extra_login}}@example.com\", \"login\": \"{{extra_login}}\", \"password\": \"Learning only 05!\", \"salt\": \"client_salt\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"redacted 422\",()=>{pm.response.to.have.status(422);const b=pm.response.json();pm.expect(b).to.eql({detail:[{type:\"invalid_request\",loc:[\"request\"],msg:\"invalid input\"}]});pm.expect(pm.response.text().includes(\"Learning only 05!\")).to.eql(false);});"
            ]
          }
        }
      ]
    },
